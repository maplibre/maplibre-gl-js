{
  "version": 8,
  "metadata": {
    "test": {
      "height": 256,
      "width": 256,
      "description": "A custom DEM encoding with all factors 0 decodes every pixel to the same elevation, so the layer renders a single flat color."
    }
  },
  "center": [-113.26903, 35.9654],
  "zoom": 11,
  "sources": {
    "source": {
      "type": "raster-dem",
      "tiles": [
        "local://tiles/{z}-{x}-{y}.terrain.png"
      ],
      "maxzoom": 15,
      "tileSize": 256,
      "encoding": "custom",
      "redFactor": 0,
      "greenFactor": 0,
      "blueFactor": 0,
      "baseShift": 0
    }
  },
  "layers": [
    {
      "id": "color-relief",
      "type": "color-relief",
      "source": "source",
      "paint": {
        "color-relief-opacity": 1,
        "color-relief-color": [
          "interpolate",
          ["linear"],
          ["elevation"],
          400, "#F00",
          800, "#AA0",
          1000, "#AF0",
          1200, "#0F0",
          1400, "#0AA",
          1600, "#00F",
          2000, "#C0C"
        ]
      }
    }
  ]
}
