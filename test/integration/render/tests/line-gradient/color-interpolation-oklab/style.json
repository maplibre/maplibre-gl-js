{
    "version": 8,
    "metadata": {
        "test": {
            "description": "Color ramps interpolated in sRGB and in OKLAB: blue to yellow, then between two oklab() colors of the same lightness, which stays even in OKLAB through a gray midpoint",
            "width": 512,
            "height": 256
        }
    },
    "zoom": 0,
    "sources": {
        "geojson": {
            "type": "geojson",
            "lineMetrics": true,
            "data": {
                "type": "FeatureCollection",
                "features": [
                    {
                        "type": "Feature",
                        "properties": {"id": "0_rgb"},
                        "geometry": {"type": "LineString", "coordinates": [[-180, 52], [180, 52]]}
                    },
                    {
                        "type": "Feature",
                        "properties": {"id": "1_oklab"},
                        "geometry": {"type": "LineString", "coordinates": [[-180, 20], [180, 20]]}
                    },
                    {
                        "type": "Feature",
                        "properties": {"id": "2_rgb"},
                        "geometry": {"type": "LineString", "coordinates": [[-180, -20], [180, -20]]}
                    },
                    {
                        "type": "Feature",
                        "properties": {"id": "3_oklab"},
                        "geometry": {"type": "LineString", "coordinates": [[-180, -52], [180, -52]]}
                    }
                ]
            }
        }
    },
    "layers": [
        {
            "id": "test_0_rgb",
            "type": "line",
            "source": "geojson",
            "filter": ["==", ["get", "id"], "0_rgb"],
            "paint": {
                "line-width": 40,
                "line-gradient": ["interpolate", ["linear"], ["line-progress"], 0, "blue", 1, "yellow"]
            }
        },
        {
            "id": "test_1_oklab",
            "type": "line",
            "source": "geojson",
            "filter": ["==", ["get", "id"], "1_oklab"],
            "paint": {
                "line-width": 40,
                "line-gradient": ["interpolate-oklab", ["linear"], ["line-progress"], 0, "blue", 1, "yellow"]
            }
        },
        {
            "id": "test_2_rgb",
            "type": "line",
            "source": "geojson",
            "filter": ["==", ["get", "id"], "2_rgb"],
            "paint": {
                "line-width": 40,
                "line-gradient": [
                    "interpolate",
                    ["linear"],
                    ["line-progress"],
                    0,
                    "oklab(0.7 0.1 0.05)",
                    1,
                    "oklab(0.7 -0.1 -0.05)"
                ]
            }
        },
        {
            "id": "test_3_oklab",
            "type": "line",
            "source": "geojson",
            "filter": ["==", ["get", "id"], "3_oklab"],
            "paint": {
                "line-width": 40,
                "line-gradient": [
                    "interpolate-oklab",
                    ["linear"],
                    ["line-progress"],
                    0,
                    "oklab(0.7 0.1 0.05)",
                    1,
                    "oklab(0.7 -0.1 -0.05)"
                ]
            }
        }
    ]
}
