    "test": {
      "height": 512,
      "width": 512,
      "allowed": 0.001,
      "description": "Same building as the `spikes` case, close enough that one tile unit is a few pixels wide. Corner arcs have to land on the integer tile grid: triangulation, subdivision and the vertex buffers snap and deduplicate vertices there, so arcs that sit between grid positions get merged and leave the roof and the walls disagreeing about where the courtyard edge is - hairline cracks and overlapping triangles. See https://github.com/maplibre/maplibre-gl-js/issues/8153"
    }
  },
