{
  "version": 8,
  "metadata": {
    "test": {
      "description": "At high latitude, globe tile selection uses the latitude-neutral zoom: the checkerboard density here matches one zoom level deeper than the display zoom.",
      "width": 256,
      "height": 256
    }
  },
  "sky": {
    "atmosphere-blend": 0.0
  },
  "center": [
    10.0,
    60.0
  ],
  "zoom": 4,
  "projection": {
    "type": "globe"
  },
  "sources": {
    "vector_tiles": {
      "type": "vector",
      "tiles": [
        "local://tiles/checkerboard.mvt"
      ]
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "white"
      }
    },
    {
      "id": "ocean",
      "type": "fill",
      "source": "vector_tiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "black"
      }
    }
  ]
}
