{
  "version": 8,
  "metadata": {
    "test": {
      "height": 256,
      "width": 256,
      "description": "Terrain tiles at the DEM source's minzoom use the DEM tile at that zoom, so the terrain keeps its relief at zoom 0."
    }
  },
  "center": [0, 0],
  "zoom": 0,
  "pitch": 60,
  "sources": {
    "terrain": {
      "type": "raster-dem",
      "tiles": ["local://tiles/12-758-1608.terrain.png"],
      "maxzoom": 12,
      "tileSize": 256
    },
    "osm": {
      "type": "raster",
      "tiles": ["local://tiles/number/{z}.png"],
      "maxzoom": 17,
      "tileSize": 256
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "white"
      }
    },
    {
      "id": "raster",
      "type": "raster",
      "source": "osm",
      "paint": {
        "raster-opacity": 1.0
      }
    }
  ],
  "terrain": {
    "source": "terrain",
    "exaggeration": 1000
  }
}
