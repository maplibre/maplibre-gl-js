{
  "version": 8,
  "metadata": {
    "test": {
      "width": 64,
      "height": 64,
      "description": "A custom layer draws a red point into the terrain tile between a blue fill below it and a black line above it.",
      "operations": [
        ["addCustomLayer", "null-island", "line"],
        ["wait"]
      ]
    }
  },
  "center": [0, 0],
  "zoom": 0,
  "sources": {
    "terrain": {
      "type": "raster-dem",
      "tiles": ["local://tiles/zero-elevation-terrain-tile.png"],
      "tileSize": 256
    },
    "polygon": {
      "type": "geojson",
      "data": {"type": "Polygon", "coordinates": [[[-12, -12], [12, -12], [12, 12], [-12, 12], [-12, -12]]]}
    },
    "line": {
      "type": "geojson",
      "data": {"type": "LineString", "coordinates": [[-18, 0], [18, 0]]}
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {"background-color": "white"}
    },
    {
      "id": "fill",
      "type": "fill",
      "source": "polygon",
      "paint": {"fill-color": "blue"}
    },
    {
      "id": "line",
      "type": "line",
      "source": "line",
      "paint": {"line-color": "black", "line-width": 2}
    }
  ],
  "terrain": {
    "source": "terrain"
  }
}
