      "tiles": [
        "local://tiles/gebco/{z}-{x}-{y}.terrain.webp"
      ],
      "tileSize": 512,
      "maxzoom": 8,
      "encoding": "mapbox"
    },
    "dem-ocean-hillshade": {
      "type": "raster-dem",
      "tiles": [
        "local://tiles/gebco/{z}-{x}-{y}.terrain.webp"
      ],
      "tileSize": 512,
      "maxzoom": 8,
      "encoding": "mapbox"
    },
