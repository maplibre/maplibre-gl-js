{
  "version": 8,
  "metadata": {
    "test": {
      "description": "Line A ends at x = 1984 of the zoom 0 tile, exactly on the left clip edge of the sliced tile 1/1/0 shown here. Each label shows the zoom of the tile that drew it: 1 when 1/1/0 loads. Slicing used to leave a one-point line there, the symbol layout threw on it, 1/1/0 failed, and its zoom 0 parent stood in, labelled 0."
    }
  },
  "center": [90, 66.51326044311186],
  "zoom": 1,
  "glyphs": "local://glyphs/{fontstack}/{range}.pbf",
  "sources": {
    "maplibre": {
      "type": "vector",
      "maxzoom": 0,
      "tiles": ["local://tiles/slice-edge-0-0-0.mvt"]
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "white"
      }
    },
    {
      "id": "line",
      "type": "line",
      "source": "maplibre",
      "source-layer": "lines",
      "paint": {
        "line-color": "black",
        "line-width": 10
      }
    },
    {
      "id": "label",
      "type": "symbol",
      "source": "maplibre",
      "source-layer": "lines",
      "layout": {
        "text-field": ["step", ["zoom"], ["concat", ["get", "name"], " 0"], 1, ["concat", ["get", "name"], " 1"]],
        "text-font": ["Open Sans Semibold", "Arial Unicode MS Bold"],
        "text-anchor": "right",
        "text-size": 48
      }
    }
  ]
}
