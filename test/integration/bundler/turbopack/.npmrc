# Install the `file:` dependency on maplibre-gl as a real copy rather than a
# symlink. Turbopack infers its project root from the nearest lockfile, and a
# symlink into the repo root makes it treat the library's own `dist/` as
# first-party source, where the worker's dynamic `new URL(..., import.meta.url)`
# becomes a hard build error instead of the warning a published package gets.
install-links=true
